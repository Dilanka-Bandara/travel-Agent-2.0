# ============================================================
# Copy this to ".env" and adjust. Nothing here is secret by default
# (local Ollama needs no keys). Fill keys only for cloud providers.
# ============================================================

# ---- LLM PROVIDER ----
# ollama = free, local on your PC. openai/gemini = cheap cloud, more reliable.
LLM_PROVIDER=ollama

# For ollama, recommended for a 4GB card (better JSON than llama3.1):
LLM_MODEL=ollama/qwen2.5:7b
# For cloud, e.g.:  gpt-4o-mini   or   gemini/gemini-2.0-flash
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT=600
LLM_TEMPERATURE=0.3

# Cloud keys (leave blank for ollama)
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- GROUNDING SOURCES (toggle freely) ----
ENABLE_WEB_SEARCH=true
ENABLE_AURELIA_BACKEND=false
ENABLE_MAPS_API=false

AURELIA_BASE_URL=http://localhost:5000
AURELIA_API_KEY=
GOOGLE_MAPS_API_KEY=

# ---- RELIABILITY ----
MAX_VALIDATION_RETRIES=2
ROUTES_PER_TRIP=3


HOTEL_PROVIDER=booking
RAPIDAPI_KEY=95dfd065a4msh5862f1c2bba9bf3p14e1d5jsn1955b549b104
RAPIDAPI_BOOKING_HOST=booking-com15.p.rapidapi.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=